# Plantilla de variables de entorno de Radar BCS.
# Copia este archivo como `.env` y llena tus valores.
# EL REPO ES PÚBLICO: jamás subas valores reales. `.env` está en .gitignore.
# Deja vacías las que no uses.

# NASA Earthdata (https://urs.earthdata.nasa.gov): MODIS, AppEEARS, etc.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Gemini (texto/imagen)
GEMINI_API_KEY=

# ElevenLabs (voz)
ELEVENLABS_API_KEY=

# Tripo3D (modelos 3D)
TRIPO_API_KEY=

# Otros modelos de lenguaje (agentes delegados)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# NO USAR (empresa china; ver regla 10 de AGENTS.md): DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Supabase (login opcional; solo la clave publishable/anon, NUNCA service_role ni sb_secret_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
